# Projeto exclusivamente esquematico (.bdf), placa DE1 Cyclone II
set_global_assignment -name FAMILY "Cyclone II"
set_global_assignment -name DEVICE EP2C20F484C7
set_global_assignment -name TOP_LEVEL_ENTITY DE1_Filtro
set_global_assignment -name BDF_FILE DE1_Filtro.bdf
set_global_assignment -name BDF_FILE Filtro3x3_Referencia.bdf
set_global_assignment -name MIF_FILE Imagem_Ruidosa_DE1.mif
set_location_assignment PIN_L1 -to CLOCK_50
set_instance_assignment -name IO_STANDARD LVTTL -to CLOCK_50
set_location_assignment PIN_R22 -to KEY[0]
set_instance_assignment -name IO_STANDARD LVTTL -to KEY[0]
